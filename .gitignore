# Virtual environments
.venv/
venv/
ENV/
env/
backend/venv/
backend/.venv/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment variables & secrets
.env
.env.local
*.log

# IDE & OS files
# Editor state stays local, but the shared settings do not: they carry the
# fix for the false Tailwind v4 at-rule errors, and every machine would
# otherwise have to rediscover that those five errors are fake.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
# Next.js / Node
/node_modules
/.next/
/out/
/build
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
